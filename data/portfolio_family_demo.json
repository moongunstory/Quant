{
  "name": "family_demo",
  "description": "selection(low_correlation + 패밀리 캡) + family 리스크 모듈 시연용. 전체 알파 풀에서 상관 0.5 미만 + 패밀리당 최대 2개로 자동 선택하고, family_corr_scale/gross_cap 을 켜서 선택 이후 상관 급등에도 반응. family 모듈 파라미터는 PROVISIONAL(Quant 데이터 미검증) — stage 리포트로 도움/손해 확인 후 baseline 반영.",
  "alphas": [],
  "selection": {
    "method": "low_correlation",
    "params": {"max_corr_threshold": 0.6, "max_per_family": 2, "top_n": 8, "min_fitness": 0.0, "min_recent_sharpe": 0.0}
  },
  "weighting": {"method": "inverse_vol", "params": {"max_weight": 0.35}},
  "risk_pipeline": [
    {"type": "position_cap", "enabled": true, "params": {}},
    {"type": "market_neutrality", "enabled": true, "params": {}},
    {"type": "family_corr_scale", "enabled": true, "params": {"lookback": 60, "min_scale": 0.3}},
    {"type": "family_gross_cap", "enabled": true, "params": {"max_gross_per_family": 0.5}},
    {"type": "vol_target", "enabled": true, "params": {"max_scale": 3.0}},
    {"type": "killswitch_v2", "enabled": true, "params": {"velocity_kill": 0.10}},
    {"type": "gross_cap", "enabled": true, "params": {"max_gross": 1.0}}
  ]
}
