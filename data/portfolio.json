  "alphas": ["clean_momentum", "funding_carry", "reversal_5d"],
  "rebalance_band": 0.0,
  "weighting": {"method": "inverse_vol", "params": {}},
  "risk_pipeline": [
    {"type": "position_cap", "enabled": true, "params": {}},
    {"type": "market_neutrality", "enabled": true, "params": {}},
    {"type": "family_corr_scale", "enabled": false, "params": {"lookback": 60, "min_scale": 0.3}},
    {"type": "family_gross_cap", "enabled": false, "params": {"max_gross_per_family": 0.5}},
    {"type": "vol_target", "enabled": true, "params": {"max_scale": 3.0}},
    {"type": "killswitch_v2", "enabled": true, "params": {"velocity_kill": 0.10}},
    {"type": "gross_cap", "enabled": true, "params": {"max_gross": 1.0}},
    {"type": "lot_rounding", "enabled": false, "params": {}}
  ]
}
